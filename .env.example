# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ragchatbot?retryWrites=true&w=majority

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRE=7d

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Options: groq | openai | gemini
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-20b

# ─── Embeddings ───────────────────────────────────────────────────────────────
# Options: xenova (free local) | openai (needs API key)
EMBEDDING_PROVIDER=xenova
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
# If using OpenAI embeddings:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ─── RAG Settings ─────────────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_TURNS=6

# ─── File Storage ─────────────────────────────────────────────────────────────
STORAGE_TYPE=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
# Production S3:
# STORAGE_TYPE=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=
# AWS_REGION=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Admin Seed ───────────────────────────────────────────────────────────────
ADMIN_NAME=IIIT Pune Admin
ADMIN_EMAIL=admin@iiitp.ac.in
ADMIN_PASSWORD=Admin@1234
